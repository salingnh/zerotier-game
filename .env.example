# Copy this file to .env, chmod 600 .env, then edit it.
# This uses the ZeroTier One SERVICE API auth token (authtoken.secret).
# Not a network ID, ZeroTier Central API token, or identity.secret.
#
# On the same Linux host as ZeroTier One:
#   sudo cat /var/lib/zerotier-one/authtoken.secret
#
# For remote controllers, use HTTPS with a valid certificate.
# Never expose controller port 9993 to the public Internet.
ZT_GAME_CONTROLLER_URL=http://127.0.0.1:9993
ZT_GAME_CONTROLLER_TOKEN=REPLACE_WITH_CONTROLLER_SERVICE_TOKEN
